# Copie para stack.env na pasta da stack no servidor e rode `chmod 600 stack.env`.
NOX_POST_TAG=
NOX_POST_DOMAIN=post.example.com
# Domínios extras servidos pela mesma stack (opcional, separados por vírgula).
NOX_POST_DOMAIN_ALIASES=
PUBLIC_URL=https://post.example.com
POSTGRES_PASSWORD=
SECRETS_KEY=
ADMIN_TOKEN=
MEDIA_MAX_MB=1024
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
