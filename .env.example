# Copie para .env (desenvolvimento) ou para o stack.env da VPS (produção).
DATABASE_URL=postgresql://noxpost:noxpost_dev@127.0.0.1:5450/noxpost
# Endereço público da API (sem barra no fim). Os callbacks do OAuth são PUBLIC_URL/oauth/<rede>/callback
# e as mídias ficam em PUBLIC_URL/media/... (a Meta precisa baixar de lá, então tem de ser público e HTTPS em produção).
PUBLIC_URL=http://localhost:3500
# Cifra os tokens das redes no banco. Mínimo 32 caracteres. Trocar invalida todos os canais conectados.
SECRETS_KEY=troque-por-uma-frase-aleatoria-com-32-ou-mais-caracteres
# Libera as rotas /admin (criar tenants). Mínimo 32 caracteres.
ADMIN_TOKEN=troque-por-outro-segredo-com-32-ou-mais-caracteres
PORT=3500
MEDIA_DIR=./storage/media
MEDIA_MAX_MB=1024

# Redes (deixe vazio para desligar). Veja o README para criar cada app e o endereço de retorno.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GMB_CLIENT_ID=
GMB_CLIENT_SECRET=
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# VK ID é cliente público (PKCE): só o id.
VK_CLIENT_ID=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Discord, Telegram, Mastodon, Bluesky, Lemmy, Farcaster, Nostr, DEV, Medium, Hashnode e WordPress não usam
# variáveis: o tenant manda as credenciais de cada conta em POST /v1/channels/connect.
